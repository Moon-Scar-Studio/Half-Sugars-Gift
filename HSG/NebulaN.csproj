<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>NebulaN</AssemblyName>
    <Product>My first plugin</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>NebulaN</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Scripts\Core\API\**" />
    <EmbeddedResource Remove="Scripts\Core\API\**" />
    <None Remove="Scripts\Core\API\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

	<Target Name="AddGameReferences" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<_LibDlls Include=".\Libs\*.dll" Exclude="..\Libs\netstandard.dll" />
			<Reference Include="@(_LibDlls->'%(FileName)')">
				<HintPath>%(FullPath)</HintPath>
				<Private>false</Private>
			</Reference>
		</ItemGroup>
	</Target>
	<ItemGroup>
		<PackageReference Include="Krafs.Publicizer" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<Publicize Include="Nebula" />
		<Publicize Include="NebulaAPI" />
	</ItemGroup>
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS0507</NoWarn>
	</PropertyGroup>
</Project>


