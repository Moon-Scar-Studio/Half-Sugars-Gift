"role.maskedDancer.name" : "Masked Dancer"
"role.maskedDancer.short" : "Dan"
"role.maskedDancer.blurb" : "Care to dance with me?"
"role.maskedDancer.doc" : "Invite three players to a party. The party can be started after the next meeting ends."
"options.role.maskedDancer.detail" : "The Masked Dancer can invite three people and start a party.<br>The party's effect depends on the invited players' factions.<br><b>This is one of Half Sugar's gifts to you!</b>"
"role.maskedDancer.ability.title" : "<b>Innate Ability [Masquerade]</b>"
"role.maskedDancer.ability.main" : "You can use <b>Invite</b> to invite three people.<br>After inviting three people and this round ends, you can <b>Start the Party</b>.<br>If all three are crewmates, nothing happens.<br>If there are two crewmates and one neutral or impostor, the neutral or impostor dies.<br>If there are no crewmates, the Masked Dancer commits suicide.<br>If there is only one crewmate, a random invited player is killed."
"role.maskeddancer.doc.invite" : "<b>Invite</b><br>Invite one person to the party"
"role.maskeddancer.doc.start" : "<b>Start Party</b><br>Can be started after inviting three people."
"role.maskedDancer.tips" : "<b>· After inviting 3 people, you must wait until the next round to start the party</b>"
"options.role.maskeddancer.inviteCooldownA" : "First Invite Cooldown"
"options.role.maskeddancer.inviteCooldownB" : "Second Invite Cooldown"
"options.role.maskeddancer.inviteCooldownC" : "Third Invite Cooldown"
"options.role.maskeddancer.partyuses" : "Party Uses"
"button.label.maskedDancer.invite" : "Invite"
"button.label.maskedDancer.start" : "Start Party"
"options.role.maskeddancer.startcooldown" : "Start Party Cooldown"
"role.wish.name" : "「Wish」"
"role.wish.blurb" : "May our next meeting not be separated by life and death"
"role.wish.short" : "Wish"
"role.wish.doc" : "Use <b>Wish</b> to mark a player, learn killer info / protect them from exile"
"role.wish.ability.title" : "<b>Innate Ability [Wish]</b>"
"role.wish.ability.main" : "You can use <b>Wish</b> to add a mark to someone.<br>When that person is marked, if they die, you learn the killer's info.<br>If they are exiled, the exile is prevented.<br>Depending on host settings, <b>Wish</b> may cause the Wish to commit suicide when applied to Impostors, Crewmates, or Neutral factions."
"role.wish.doc.wishSkill" : "<b>Wish</b><br>Mark others during the action phase"
"role.wish.tips" : " "
"options.role.wish.detail" : "Wish can mark others and produce skill effects<br><b>This is one of Half Sugar's gifts to you!</b>"
"options.role.wish.MarkCoolDown" : "Skill Cooldown"
"options.role.wish.MarkMaxUses" : "Max Skill Uses"
"options.role.wish.suicideImpostor" : "Suicide when Wishing an Impostor"
"options.role.wish.suicideNeutral" : "Suicide when Wishing a Neutral"
"options.role.wish.suicideCrewmate" : "Suicide when Wishing a Crewmate"
"button.label.wish.mark" : "Wish"
"role.wish.markdead" : "「Wish」The starlight named \"<color=%COLOR%>%VICTIM%</color>\" in the starry sky<br>faded away in the hands of \"%KILLER%\"."
"role.wish.murdererdead" : "「Wish」The starlight named \"<color=%COLOR%>%VICTIM%</color>\" in the starry sky<br>faded away together with their killer."
"role.snitch.name" : "Snitch"
"role.snitch.blurb" : "I will definitely bring this intel back safely!"
"role.snitch.short" : "Snt"
"role.snitch.canBeGuess.true" : "You can still be guessed"
"role.snitch.canBeGuess.false" : "You cannot be guessed"
"role.snitch.imposter.all" : "Learn all Impostors"
"role.snitch.imposter.count" : "Learn %COUNT% Impostor(s)"
"role.snitch.neutral.any" : "and all Neutrals"
"role.snitch.neutral.evilOnly" : "and Evil Neutrals"
"role.snitch.neutral.none" : ""
"options.role.snitch.detail" : "After completing all tasks, the Snitch can learn the locations of Impostors or Neutrals.<br><b>This is one of Half Sugar's gifts to you!</b>"
"role.snitch.doc" : "After completing all tasks, the Snitch can learn the locations of <b><color=#00ffff>%ImpInfo%%NeuInfo%</color></b>.<br>However, when the Snitch has one task remaining, all Impostors receive a notification. At that point, <b><color=#00ffff>%CanBeGuessed%</color></b>."
