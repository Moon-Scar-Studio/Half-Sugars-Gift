"role.lurker.name" : "Lurker"
"role.lurker.short" : "Lur"
"role.lurker.blurb" : "Through thick and thin"
"options.role.lurker.ckc" : "Can Kill"
"options.role.lurker.cooldown" : "Kill Cooldown"
"options.role.lurker.nt" : "Lurker Has No Tasks"
"button.label.lurker.kill" : "Kill"
"options.role.lurker.detail" : "The Lurker blocks every faction other than the crewmates from winning<br>until they die.<br><b>One of the gifts from Half Sugar!</b>"
"role.lurker.doc" : "The Lurker blocks every faction other than the crewmates from winning until the Lurker dies.<b><color=#00ffff>%CANKILL%</color></b>%NT%"
"role.lurker.ck.true" : "<br>When a non-crewmate faction would have won, <b>the Lurker gains the ability to kill</b>, with a cooldown of <b><color=#00ffff>%CD%s</color></b> "
"role.lurker.ck.false" : ""
"role.lurker.nt.true" : ", <b><color=#00ffff><br>and the Lurker has no tasks.</color></b>"
"role.lurker.nt.false" : "."
"role.dilemma.name" : "Dilemma"
"role.dilemma.blurb" : "What is your choice?"
"options.role.dilemma.detail" : "Press the button to trigger a random event.<br><b>One of the gifts from Half Sugar!</b>"
"role.dilemma.doc" : "Press the button to trigger a random event."
"role.dilemma.ability.title" : "[Ability] Choice"
"role.dilemma.ability.main" : "A manual is attached to the button listing the possible events.<b><br>1. Call an emergency meeting in your name<br>2. Kill an impostor; nothing happens if there is none.<br>3. Explode (only kills the user)<br>4. Become a plain crewmate again<br>5. Give a random player a green key (the Key Master modifier)<br>6. Swap roles with a random player.</b>"
"role.dilemma.ability.doc" : "<b>Choice</b><br>Press the button to start a Choice event."
"role.dilemma.hudtextSuicide" : "(explosion)"
"options.role.dilemma.maxUses" : "Max Ability Uses"
"options.role.dilemma.cooldown" : "Ability Cooldown"
"options.role.dilemma.AddMaxUsesWhenDoTask" : "Gain Uses by Doing Tasks"
"options.role.dilemma.NeedTasksCount" : "Tasks Required per Extra Use"
"button.label.dilimma.choose" : "Choose"
"role.dilemma.hudtextKillImp" : "It seems an impostor has died..."
"role.dilemma.hudtextNoImp" : "There are no impostors left"
"role.dilemma.hudtextBeCrew" : "The button is gone?"
"role.dilemma.hudtextAddModi" : "Someone got a key"
"role.dilemma.hudtextChangeRole" : "Who... is this?"
"role.dilemma.hudtextUn" : "This can't be"
"role.karmatic.name" : "Karmatic"
"role.karmatic.blurb" : "Isn't sweet karma your shelter too?"
"role.karmatic.doc" : "The Karmatic can use the 'Causality Chain' to pick a player and give them karmic retribution.<br>Karma takes effect next round."
"options.role.karmatic.detail" : "The Karmatic can use the 'Causality Chain' to give a player karmic retribution.<br><b>One of the gifts from Half Sugar!</b>"
"role.karmatic.ability.title" : "[Ability] Karmic Retribution"
"role.karmatic.doc.causalitychain" : "<b>Causality Chain</b><br>Follow a player for <b><color=#00ffff>%FT%s</color></b> to give them the Karma modifier.<br>Up to <b><color=#00ffff>%MaxUses%</color></b> uses, with a cooldown of <b><color=#00ffff>%CD%s</color></b>."
"role.karmatic.ability.main" : "Use the <b>Causality Chain</b> to pick a player; they receive the Karma modifier at the end of this round.<br>Then, %NameDeco%.<br>When a Karma holder tries to kill, the kill fails, and %TryKillSomebody%.<br>The Karma modifier is removed after <b><color=#00ffff>%MeetingTimes% round(s)</color></b>."
"options.role.karmatic.NameDeco.K.Des" : "<b><color=#00ffff>Karma holders get a purple 'K' suffix in your view.</color></b>"
"options.role.karmatic.NameDeco.Color.Des" : "<b><color=#00ffff>Karma holders' names turn purple in your view</color></b>"
"options.role.karmatic.deadkillkarma.true" : "<b><color=#00ffff>the victim kills the Karma holder back.</color></b>"
"options.role.karmatic.deadkillkarma.false" : "<b><color=#00ffff>the Karma holder commits suicide</color></b>"
"options.role.karmatic.CausalityChainCoolDown" : "Causality Chain Cooldown"
"options.role.karmatic.followtime" : "Follow Time to Apply the Chain"
"options.role.karmatic.CausalityChainMaxUses" : "Max Causality Chain Uses"
"options.role.karmatic.EraseKarmaMeetingTimes" : "Rounds Until Karma Is Removed"
"options.role.karmatic.deadkillkarma" : "Victim Kills Karma Holder Back"
"options.role.karmatic.deadkillkarma.detail" : "When enabled, the victim kills the Karma holder directly.<br>When disabled, the Karma holder commits suicide before the kill."
"options.role.karmatic.NameDeco" : "Karma Name Decoration"
"options.role.karmatic.NameDeco.K" : "Append 'K' to the Name"
"options.role.karmatic.NameDeco.Color" : "Turn the Name Purple"
"options.role.karmatic.NeedImp" : "Retribution Only for Impostor Karma Holders"
"options.role.karmatic.NeedImp.detail" : "When enabled, retribution does not trigger if the Karma holder is not an impostor."
"button.label.CausalityChain" : "Causality Chain"
"role.karmatic.tips" : "<b>- Karma applied with the 'Causality Chain' does not appear immediately; it is applied at the end of the round.</b>"
"role.saboteur.name" : "Saboteur"
"role.saboteur.short" : "Sab"
"role.saboteur.blurb" : "The power of chaos"
"role.saboteur.doc" : "Every time a sabotage is fixed, your kill cooldown is permanently reduced.<br>Killing during a sabotage further reduces the cooldown for that sabotage.<br>The number of permanent reductions and the amounts are set by the host."
"options.role.saboteur.detail" : "The Saboteur gains kill cooldown reductions after and during sabotages.<br><b>One of the gifts from Half Sugar!</b>"
"options.role.saboteur.killcooldown" : "Kill Cooldown"
"options.role.saboteur.reduceSabotage" : "Permanent Reduction per Sabotage"
"options.role.saboteur.reduceKill" : "Reduction per Kill During Sabotage"
"options.role.saboteur.minCooldown" : "Minimum Kill Cooldown"
"options.role.saboteur.maxStack" : "Max Permanent Reductions"
"role.saboteur.ability.doc" : "Every time a sabotage is fixed, your kill cooldown is permanently reduced.<br>Killing during a sabotage further reduces the cooldown for that sabotage.<br>The number of permanent reductions and the amounts are set by the host."
"role.mage.name" : "Mage"
"role.mage.short" : "Mag"
"role.mage.blurb" : "Crushed by fragility, or recall your purest self"
"role.mage.doc" : "Curse a target with weakness; the restless will be sacrificed to your magic. Or quietly restore them to how they began?"
"options.role.mage.detail" : "The Mage curses a target with weakness so they die when doing a task or using an ability.<br>The second persona's kills leave only ashes.<br><b>One of the gifts from Half Sugar!</b>"
"role.mage.ability.title" : "<b>[Ability] Two Faces</b>"
"role.mage.ability.main" : "In the first persona, use Weakness: the target dies after doing a task or using an ability.<br>In the second persona, use Restore: an area kill that leaves only ashes"
"role.mage.doc.weak" : "<b>Weakness</b><br>Curse a target with weakness; they die after doing a task or using an ability<br><b>Only available in the first persona</b>"
"role.mage.doc.restore" : "<b>Restore</b><br>Every target within range dies, leaving only ashes<br><b>Only available in the second persona</b>"
"role.mage.tips" : "Watch me turn into a witch, children"
"role.mage.switched" : "You lost control!!!"
"role.mage.backToFirst" : "The magic is suppressed... for now"
"role.mage.weaknessTriggered" : "%PLAYER% died from your curse."
"options.role.mage.requiredKillCount" : "Kills Needed to Switch Persona"
"options.role.mage.weakCooldown" : "Weakness Cooldown"
"options.role.mage.restoreRadius" : "Restore Radius"
"options.role.mage.restoreCooldown" : "Restore Cooldown"
"options.role.mage.weaknessEnableRoundExpiry" : "Weakness Expires After Rounds"
"options.role.mage.weaknessEnableRoundExpiry.detail" : "When enabled, Weakness is removed automatically after the given number of rounds."
"options.role.mage.weaknessExpiryRounds" : "Weakness Duration (Rounds)"
"button.label.mage.weak" : "Curse"
"button.label.mage.restore" : "Restore"
"role.imagination.ability.doc" : "<b>Imagine</b><br>Triggers automatically every round: pick a role and gain its abilities."
"options.role.imagination.filter" : "Selectable Role Filter"
"role.blitz.name" : "Blitz"
"role.blitz.short" : "%"
"role.blitz.generalBlurb" : "Charge!"
"options.role.blitz.detail" : "At game start and after every meeting,<br>your <b>second</b> kill cooldown is immediately reset to <b><color=#FF0000>0s</color>.</b><b>One of the gifts from Half Sugar!</b>"
"role.blitz.doc" : "At game start and after every meeting, your <b>second</b> kill cooldown is immediately reset to <b><color=#FF0000>0s</color></b>."
"role.imaginationM.name" : "Imagination"
"role.imaginationM.short" : "Ima"
"role.imaginationM.generalBlurb" : "A vivid imagination"
"role.imaginationM.doc" : "Survive to the end and steal the victory<br>Imagine a role every round and gain its abilities."
"options.role.imaginationM.candidateCount" : "Roles Offered per Round"
"options.role.imaginationM.roleFilter" : "Imaginable Roles"
"options.role.imaginationM.detail" : "Imagination can imagine a role every round and gain its traits,<br>and steals the victory by surviving to the end.<br><b>One of the gifts from Half Sugar!</b>"
"role.imaginationM.ability.title" : "<b>[Ability] Boundless Imagination</b>"
"role.imaginationM.ability.main" : "At game start and after every meeting, choose a role and gain its abilities.<br>At the end of the round you must choose again."
"role.imaginationM.ability.doc" : "<b>Imagine</b><br>Triggers automatically every round: pick a role and gain its abilities."
"role.imaginationM.tips" : "<b>- When no role is left to choose, you die.</b>"
"role.imaginationM.prefix" : "Imagined %ROLE%"
"role.imaginationM.select" : "Choose a role to imagine"
"role.keymaster.short" : ">"
"options.modifier.keymaster.Specooldown" : "Decontamination Door Cooldown"
"role.HIGH.name" : "Tall"
"role.HIGH.short" : "H"
"role.HIGH.generalBlurb" : "Growing upward"
"options.role.HIGH.detail" : "...<b>One of the gifts from Half Sugar!</b>"
"role.HIGH.doc" : "Your height changes at random.<br><b>You are the tall one now.</b><size=0.5><i>...or maybe the short one</i></size>"
"options.modifier.high.min" : "Minimum Height"
"options.modifier.high.max" : "Maximum Height"
"options.modifier.high.jiange" : "Change Interval"
"role.WIDE.name" : "Wide"
"role.WIDE.generalBlurb" : "Growing sideways"
"role.WIDE.short" : "W"
"options.role.WIDE.detail" : "...<b>One of the gifts from Half Sugar!</b>"
"role.WIDE.doc" : "Your width changes at random.<br><b>You wide noodle.</b>"
"options.modifier.wide.min" : "Minimum Width"
"options.modifier.wide.max" : "Maximum Width"
"options.modifier.wide.jiange" : "Change Interval"
"role.turtle.name" : "Turtle"
"role.turtle.short" : "Tur"
"role.turtle.generalBlurb" : "Slow and steady"
"role.turtle.doc" : "You walk slowly."
"options.role.turtle.detail" : "Players with the Turtle modifier walk slower.<br><b>One of the gifts from Half Sugar!</b>"
"role.sharpeye.name" : "Sharp Eye"
"role.sharpeye.short" : "Shp"
"role.sharpeye.generalBlurb" : "I felt that!"
"role.sharpeye.doc" : "Your screen flashes whenever someone changes role."
"options.role.sharpeye.detail" : "The Sharp Eye is alerted whenever someone changes role.<br><b>One of the gifts from Half Sugar!</b>"
"role.rainbowcandy.name" : "Rainbow Candy"
"role.rainbowcandy.short" : "Rbw"
"role.rainbowcandy.generalBlurb" : "Colors of brilliance"
"role.rainbowcandy.doc" : "Your color changes at random."
"options.role.rainbowcandy.detail" : "The Rainbow Candy's color changes at random.<br><b>One of the gifts from Half Sugar!</b>"
"options.modifier.rainbowcandy.interval" : "Change Interval"
"role.weakness.name" : "Weakness"
"role.weakness.short" : "Wk"
"role.weakness.generalBlurb" : "You're so weak"
"role.glimmer.name" : "Glimmer"
"role.glimmer.short" : "Gli"
"role.glimmer.blurb" : "A glimmer of light in despair"
"role.glimmer.doc" : "Choose a player to make their screen flash."
"options.role.glimmer.uses" : "Uses"
"options.role.glimmer.cooldown" : "Ability Cooldown"
"options.role.glimmer.flashDuration" : "Flash Duration"
"options.role.glimmer.flashcolor" : "Flash Color"
