"role.mirrorpeeper.name" : "Mirror Peeper"
"role.mirrorpeeper.short" : "Mir"
"role.mirrorpeeper.blurb" : "Secrets through the glass"
"options.role.mirrorpeeper.detail" : "After using the ability, the Mirror Peeper is notified of certain events<br>according to the host's settings.<br><b>One of the gifts from Half Sugar!</b>"
"options.role.mirrorpeeper.cooldown" : "Mirror Cooldown"
"options.role.mirrorpeeper.maxUses" : "Max Mirror Uses"
"options.role.mirrorpeeper.guewillq" : "Flash When Someone Dies in a Meeting"
"options.role.mirrorpeeper.DieWillQ" : "Flash When Someone Dies"
"options.role.mirrorpeeper.towq" : "Flash When Someone Finishes a Task"
"options.role.mirrorpeeper.gcd" : "Flash Color: Meeting Death (Suicide)"
"options.role.mirrorpeeper.gcmd" : "Flash Color: Meeting Death (Killed by Another)"
"options.role.mirrorpeeper.tc" : "Flash Color: Task Finished"
"options.role.mirrorpeeper.dc" : "Flash Color: Death"
"role.mirrorpeeper.doc" : "You will be notified when certain events happen."
"role.mirrorpeeper.ability.title" : "<b>[Ability] Mirror of Heaven</b>"
"role.mirrorpeeper.ability.main" : "Use the 'Mirror' ability; it takes effect during the next round and the next meeting."
"role.mirrorpeeper.doc.Monitoring" : "<b>Mirror</b><br>While active: <b><color=#00ffff>%DeathFlash_1%</color></b> %DeathFlashColor% <b><color=#00ffff>%DeathFlash_2%</color></b><b><color=#00ffff>%TaskFlash_1%</color></b> %TaskFlashColor% <b><color=#00ffff>%TaskFlash_2% </color></b><b><color=#00ffff>%GuessCorrectFlash_1% </color></b> %GuessCorrectFlashColor% <b><color=#00ffff>%GuessCorrectFlash_2%</color></b><b><color=#00ffff>%GuessWrongFlash_1% </color></b>%GuessWrongFlashColor% <b><color=#00ffff>%GuessWrongFlash_2%</color></b>"
"role.mirrorpeeper.tips" : "<b>- Meeting suicides and kills usually correspond to wrong and correct guesses,<br>but the Mirror reacts to any death during a meeting,<br>not only guesses.</b>"
"role.mirrorpeeper.desc.death.prefix" : "<br>When someone dies, your screen flashes "
"role.mirrorpeeper.desc.death.suffix" : "."
"role.mirrorpeeper.desc.task.prefix" : "<br>When someone finishes a task, your screen flashes "
"role.mirrorpeeper.desc.task.suffix" : "."
"role.mirrorpeeper.desc.guess.correct.prefix" : "<br>When someone commits suicide in a meeting, your screen flashes "
"role.mirrorpeeper.desc.guess.correct.suffix" : "."
"role.mirrorpeeper.desc.guess.wrong.prefix" : "<br>When someone is killed by another player in a meeting, your screen flashes "
"role.mirrorpeeper.desc.guess.wrong.suffix" : "."
