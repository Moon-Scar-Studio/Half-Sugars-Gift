"role.mirrorpeeper.name" : "Mirror Peeper"
"role.mirrorpeeper.short" : "Mir"
"role.mirrorpeeper.blurb" : "Peering into arcane secrets"
"options.role.mirrorpeeper.detail" : "After using the skill, the Mirror Peeper can learn about certain events depending on host settings.<br><b>This is one of Half Sugar's gifts to you!</b>"
"options.role.mirrorpeeper.cooldown" : "Mirror Cooldown"
"options.role.mirrorpeeper.maxUses" : "Max Mirror Uses"
"options.role.mirrorpeeper.guewillq" : "Flash when someone dies in a meeting"
"options.role.mirrorpeeper.DieWillQ" : "Flash when someone dies"
"options.role.mirrorpeeper.towq" : "Flash when someone completes a task"
"options.role.mirrorpeeper.gcd" : "Flash color when someone dies in a meeting by suicide"
"options.role.mirrorpeeper.gcmd" : "Flash color when someone dies in a meeting and the killer is not the victim"
"options.role.mirrorpeeper.tc" : "Flash color when someone completes a task"
"options.role.mirrorpeeper.dc" : "Flash color when someone dies"
"role.mirrorpeeper.doc" : "When certain events occur, you will receive a notification."
"role.mirrorpeeper.ability.title" : "<b>[Innate Ability] Heaven-Peering Mirror</b>"
"role.mirrorpeeper.ability.main" : "You can use the skill 「Mirror Peep」. After use, it takes effect in the next round and the next meeting."
"role.mirrorpeeper.doc.Monitoring" : "<b>Mirror Peep</b><br>When active, <b><color=#00ffff>%DeathFlash_1%</color></b> %DeathFlashColor% <b><color=#00ffff>%DeathFlash_2%</color></b><b><color=#00ffff>%TaskFlash_1%</color></b> %TaskFlashColor% <b><color=#00ffff>%TaskFlash_2% </color></b><b><color=#00ffff>%GuessCorrectFlash_1% </color></b> %GuessCorrectFlashColor% <b><color=#00ffff>%GuessCorrectFlash_2%</color></b><b><color=#00ffff>%GuessWrongFlash_1% </color></b>%GuessWrongFlashColor% <b><color=#00ffff>%GuessWrongFlash_2%</color></b>"
"role.mirrorpeeper.tips" : "<b>· Although in most cases meeting suicides and kills correspond to wrong guesses and being guessed,<br>the Mirror Peep skill actually reacts to any death in a meeting,<br>not just being guessed or wrong guessing.</b>"
"role.mirrorpeeper.desc.death.prefix" : "<br>When someone dies, your screen will flash"
"role.mirrorpeeper.desc.death.suffix" : "light"
"role.mirrorpeeper.desc.task.prefix" : "<br>When someone completes a task, your screen will flash"
"role.mirrorpeeper.desc.task.suffix" : "light"
"role.mirrorpeeper.desc.guess.correct.prefix" : "<br>When someone commits suicide in a meeting, your screen will flash"
"role.mirrorpeeper.desc.guess.correct.suffix" : "light"
"role.mirrorpeeper.desc.guess.wrong.prefix" : "<br>When someone dies in a meeting and the killer is not the victim, your screen will flash"
"role.mirrorpeeper.desc.guess.wrong.suffix" : "light"
"options.role.mirrorpeeper.red" : "<b><color=#FF0000>Red</color></b>"
"options.role.mirrorpeeper.yellow" : "<b><color=#FFFF00>Yellow</color></b>"
"options.role.mirrorpeeper.cyan" : "<b><color=#00EEEE>Cyan</color></b>"
"options.role.mirrorpeeper.green" : "<b><color=#00FF00>Green</color></b>"
"options.role.mirrorpeeper.blue" : "<b><color=#0000FF>Blue</color></b>"
"options.role.mirrorpeeper.purple" : "<b><color=#800080>Purple</color></b>"
