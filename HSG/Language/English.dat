"options.role.glimmer.flashcolor.followtarget" : "Use the Target's Player Color"
"role.karma.name" : "Karma"
"role.karma.generalBlurb" : "Your retribution"
"role.karma.doc" : "When you try to kill, depending on the host's settings, you are killed back or commit suicide.<br>This modifier is removed automatically after X rounds, as set by the host."
"options.role.karma.detail" : "If a Karma holder tries to kill, the Karma holder dies."
