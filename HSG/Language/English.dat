"role.turtle.name" : "Turtle"
"role.turtle.short" : "Turtle"
"role.turtle.generalBlurb" : "Dawdle dawdle"
"role.turtle.doc" : "You walk very slowly."
"options.role.turtle.detail" : "Those with the Turtle modifier walk slower<br><b>This is one of Half Sugar's gifts to you!</b>"
"role.sharpeye.name" : "Sharp Eye"
"role.sharpeye.short" : "Eye"
"role.sharpeye.generalBlurb" : "I sensed it!"
"role.sharpeye.doc" : "When someone changes roles, you will receive a flash notification."
"options.role.sharpeye.detail" : "Sharp Eye receives a notification when someone changes roles.<br><b>This is one of Half Sugar's gifts to you!</b>"
"role.rainbowcandy.name" : "Rainbow Candy"
"role.rainbowcandy.short" : "RB"
"role.rainbowcandy.generalBlurb" : "Dazzling colors"
"role.rainbowcandy.doc" : "Your color changes randomly."
"options.role.rainbowcandy.detail" : "Rainbow Candy's color changes randomly.<br><b>This is one of Half Sugar's gifts to you!</b>"
"options.modifier.rainbowcandy.interval" : "Change Interval"
