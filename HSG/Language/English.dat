# ==== 星云创意表新增职业 / Roles added from the idea sheet ====
"role.forbiddenLove.name" : "Forbidden Love"
"role.forbiddenLove.short" : "Love"
"role.forbiddenLove.blurb" : "I'll stay with you until the very end."
"role.forbiddenLove.doc" : "You form a special bond. <b>Every killer can see you</b>, and you cannot win with any faction. Survive together to the end to <b>win alone</b>."
"role.forbiddenLove.generalBlurb" : "I'll stay with you until the very end."
"options.role.forbiddenLove.detail" : "A paired neutral bond, visible to all killers. Both must survive to win."
"options.modifier.forbiddenLove.detail" : "A paired neutral bond, visible to all killers. Both must survive to win."
"role.fervor.name" : "Fervor"
"role.fervor.short" : "Fvr"
"role.fervor.blurb" : "One more time!"
"role.fervor.doc" : "You act <b>twice</b> per cooldown: the first use runs the normal cooldown, the next one is instant."
"role.fervor.generalBlurb" : "One more time!"
"options.role.fervor.detail" : "Lets the holder use their ability or kill twice per cooldown."
"options.modifier.fervor.detail" : "Lets the holder use their ability or kill twice per cooldown."
"role.smokescreen.name" : "Smokescreen"
"role.smokescreen.short" : "Smk"
"role.smokescreen.blurb" : "You can't see me."
"role.smokescreen.doc" : "During meetings you are <b>immune to abilities</b>: you cannot be guessed, judged, or killed by meeting abilities."
"role.smokescreen.generalBlurb" : "You can't see me."
"options.role.smokescreen.detail" : "Makes the holder immune to targeted abilities during meetings."
"options.modifier.smokescreen.detail" : "Makes the holder immune to targeted abilities during meetings."
"role.servant.name" : "Servant"
"role.servant.short" : "Srv"
"role.servant.blurb" : "Fine, I'll do it."
"role.servant.doc" : "You were recruited by the Plantation Owner. Do tasks for them; <b>you return to your original role when they die</b>."
"role.servant.generalBlurb" : "Fine, I'll do it."
"options.role.servant.detail" : "A sub-role created by the Plantation Owner."
"options.modifier.servant.detail" : "A sub-role created by the Plantation Owner."
"role.crowned.name" : "Crowned"
"role.crowned.short" : "Crn"
"role.crowned.blurb" : "Thank you, Your Majesty."
"role.crowned.doc" : "The King crowned you: your vote counts <b>twice</b>, and you <b>die in the King's place</b> when he is attacked."
"role.crowned.generalBlurb" : "Thank you, Your Majesty."
"options.role.crowned.detail" : "A sub-role created by the King."
"options.modifier.crowned.detail" : "A sub-role created by the King."
"role.hypnotized.name" : "Hypnotized"
"role.hypnotized.short" : "Hyp"
"role.hypnotized.blurb" : "My body won't obey me."
"role.hypnotized.doc" : "The Owl hypnotized you: you gain a <b>one-shot knife</b> and count as an Impostor. Kill once to return to normal; <b>otherwise you die when time runs out</b>. The Owl can devour you at any moment."
"role.hypnotized.generalBlurb" : "My body won't obey me."
"options.role.hypnotized.detail" : "A sub-role created by the Owl."
"options.modifier.hypnotized.detail" : "A sub-role created by the Owl."
"role.cinnabarred.name" : "Cinnabarred"
"role.cinnabarred.short" : "Cnb"
"role.cinnabarred.blurb" : "What is this feeling..."
"role.cinnabarred.doc" : "The Cinnabar marked you, forming a <b>one-way bond</b>. <b>You die of poison if the Cinnabar dies</b>, but you can win alongside them while alive."
"role.cinnabarred.generalBlurb" : "What is this feeling..."
"options.role.cinnabarred.detail" : "A sub-role created by the Cinnabar."
"options.modifier.cinnabarred.detail" : "A sub-role created by the Cinnabar."
"role.rescued.name" : "Rescued"
"role.rescued.short" : "Rsc"
"role.rescued.blurb" : "I can't believe someone this kind exists."
"role.rescued.doc" : "The Savior brought you back. You <b>win with the Savior</b>, but <b>die when they die</b>. You are alerted whenever someone dies."
"role.rescued.generalBlurb" : "I can't believe someone this kind exists."
"options.role.rescued.detail" : "A sub-role created by the Savior."
"options.modifier.rescued.detail" : "A sub-role created by the Savior."
"role.admirer.name" : "Admirer"
"role.admirer.short" : "Adm"
"role.admirer.blurb" : "What a beautiful painting."
"role.admirer.doc" : "You accepted the Artist's painting and now <b>stand with them</b>, winning when they win."
"role.admirer.generalBlurb" : "What a beautiful painting."
"options.role.admirer.detail" : "A sub-role created by the Artist."
"options.modifier.admirer.detail" : "A sub-role created by the Artist."
"role.gemShield.name" : "Gem Shield"
"role.gemShield.short" : "Gem"
"role.gemShield.blurb" : "Better to shatter than yield."
"role.gemShield.doc" : "The Jade gave you a <b>one-time shield</b> that blocks a single kill for a limited time."
"role.gemShield.generalBlurb" : "Better to shatter than yield."
"options.role.gemShield.detail" : "A sub-role granted by the Jade."
"options.modifier.gemShield.detail" : "A sub-role granted by the Jade."
"role.bugged.name" : "Bugged"
"role.bugged.short" : "Bug"
"role.bugged.blurb" : "What just happened?"
"role.bugged.doc" : "The Coder planted a bug on you: <b>your next kill fails</b> and goes straight into cooldown."
"role.bugged.generalBlurb" : "What just happened?"
"options.role.bugged.detail" : "A sub-role planted by the Coder."
"options.modifier.bugged.detail" : "A sub-role planted by the Coder."
"role.poisoned.name" : "Poisoned"
"role.poisoned.short" : "Psn"
"role.poisoned.blurb" : "My blood is burning."
"role.poisoned.doc" : "The Toxin poisoned you: <b>your next ability is guaranteed to kill its target</b>, and the death is blamed on you."
"role.poisoned.generalBlurb" : "My blood is burning."
"options.role.poisoned.detail" : "A sub-role created by the Toxin."
"options.modifier.poisoned.detail" : "A sub-role created by the Toxin."
"role.possessed.name" : "Possessed"
"role.possessed.short" : "Pss"
"role.possessed.blurb" : "Something crawled inside me."
"role.possessed.doc" : "The Wraith possessed you. While possessed you wield a knife with a <b>3-second cooldown</b>."
"role.possessed.generalBlurb" : "Something crawled inside me."
"options.role.possessed.detail" : "A sub-role created by the Wraith."
"options.modifier.possessed.detail" : "A sub-role created by the Wraith."
"role.anesthetized.name" : "Anesthetized"
"role.anesthetized.short" : "Ane"
"role.anesthetized.blurb" : "So dizzy..."
"role.anesthetized.doc" : "You were anesthetized. <b>After the meeting</b> your movement is flipped, and you <b>die the moment you report a body or call a meeting</b>."
"role.anesthetized.generalBlurb" : "So dizzy..."
"options.role.anesthetized.detail" : "A sub-role inflicted by the Anesthetist."
"options.modifier.anesthetized.detail" : "A sub-role inflicted by the Anesthetist."
"role.count.name" : "Count"
"role.count.short" : "Cnt"
"role.count.blurb" : "My will shall be inherited forever."
"role.count.doc" : "You carry one extra <b>inheritance task</b>. If you die after finishing all tasks, you <b>revive next round as the Heir</b>, who can <b>execute anyone</b> during a meeting."
"role.count.generalBlurb" : "My will shall be inherited forever."
"options.role.count.detail" : "The Count revives as the Heir after dying with tasks done, gaining a meeting execution."
"options.modifier.count.detail" : "The Count revives as the Heir after dying with tasks done, gaining a meeting execution."
"role.giver.name" : "Giver"
"role.giver.short" : "Giv"
"role.giver.blurb" : "I have whatever you need."
"role.giver.doc" : "Pick a player, then choose a role from random candidates to grant them that role's <b>ability for a single use</b>. Their own role is unchanged.<br>The ability expires after one use; passive or meeting-only abilities last until the end of the next meeting.<br><b>Giving to an Impostor kills you on the spot.</b> Limited uses."
"role.giver.generalBlurb" : "I have whatever you need."
"options.role.giver.detail" : "The Giver can grant crewmates a single use of another role's ability. Give it to the wrong person and it costs your life."
"options.modifier.giver.detail" : "The Giver hands other roles to crewmates — and dies if they pick an Impostor."
"role.hunter.name" : "Hunter"
"role.hunter.short" : "Hnt"
"role.hunter.blurb" : "An eye for an eye."
"role.hunter.doc" : "Mark a suspect during the meeting. <b>When you are voted out, you take them with you.</b>"
"role.hunter.generalBlurb" : "An eye for an eye."
"options.role.hunter.detail" : "The Hunter drags a suspect along when voted out."
"options.modifier.hunter.detail" : "The Hunter drags a suspect along when voted out."
"role.plantation.name" : "Plantation Owner"
"role.plantation.short" : "Plt"
"role.plantation.blurb" : "Get to work, my servant."
"role.plantation.doc" : "You <b>cannot do tasks yourself</b> but still have a quota. Recruit Servants to work for you; <b>if the quota isn't met in time you die</b>."
"role.plantation.generalBlurb" : "Get to work, my servant."
"options.role.plantation.detail" : "The Plantation Owner recruits Servants to finish their quota, or dies on the deadline."
"options.modifier.plantation.detail" : "The Plantation Owner recruits Servants to finish their quota, or dies on the deadline."
"role.king.name" : "King"
"role.king.short" : "Kng"
"role.king.blurb" : "How are you, my subjects?"
"role.king.doc" : "Crown a <b>Crewmate</b> to double their vote; <b>crowning anyone else gets you assassinated</b>. Your crowned subject dies in your place; once they're gone you are <b>revealed and immune to guessing</b>, and may crown again."
"role.king.generalBlurb" : "How are you, my subjects?"
"options.role.king.detail" : "The King trades a crown for a double vote and a body double — but crowning wrong is fatal."
"options.modifier.king.detail" : "The King trades a crown for a double vote and a body double — but crowning wrong is fatal."
"role.discerner.name" : "Discerner"
"role.discerner.short" : "Dsc"
"role.discerner.blurb" : "I see through your malice."
"role.discerner.doc" : "Mark a player. <b>If they kill while the mark lasts you are alerted</b> and the cooldown refreshes; otherwise the mark clears and your cooldown grows."
"role.discerner.generalBlurb" : "I see through your malice."
"options.role.discerner.detail" : "The Discerner marks players — a hit refreshes the cooldown, a miss penalizes it."
"options.modifier.discerner.detail" : "The Discerner marks players — a hit refreshes the cooldown, a miss penalizes it."
"role.tofuLover.name" : "Tofu Lover"
"role.tofuLover.short" : "Tofu"
"role.tofuLover.blurb" : "All for the tofu!"
"role.tofuLover.doc" : "You can eat the <b>Spectre's dishes</b> scattered around the map. Each one restores 1 satiety (about %SEC% seconds), and while satiety lasts you can use the Spectre's <b>Vanish</b>. <b>Running out doesn't starve you</b> — you just lose the ability. Every dish you eat is one the Spectre doesn't get."
"role.tofuLover.generalBlurb" : "All for the tofu!"
"options.role.tofuLover.detail" : "The Tofu Lover borrows the Spectre's ability by stealing its dishes. <b>Requires the Spectre to be enabled.</b>"
"role.ultramarine.name" : "Ultramarine"
"role.ultramarine.short" : "Ult"
"role.ultramarine.blurb" : "Let me sketch your light and shadow."
"role.ultramarine.doc" : "Use <b>Depict</b> on a player during a meeting to publicly narrow their faction down to <b>one of two</b> words (black / white / grey). The result lasts one meeting."
"role.ultramarine.generalBlurb" : "Let me sketch your light and shadow."
"options.role.ultramarine.detail" : "The Ultramarine publicly narrows a player's faction to two options."
"options.modifier.ultramarine.detail" : "The Ultramarine publicly narrows a player's faction to two options."
"role.ochre.name" : "Ochre"
"role.ochre.short" : "Och"
"role.ochre.blurb" : "I'll paint every peak."
"role.ochre.doc" : "<b>Dye</b> a player so they can see a random same-faction player — the two become <b>Confidants</b> who see each other but not you. All Neutrals count as one side."
"role.ochre.generalBlurb" : "I'll paint every peak."
"options.role.ochre.detail" : "The Ochre links players so same-faction members can recognise each other."
"options.modifier.ochre.detail" : "The Ochre links players so same-faction members can recognise each other."
"role.crimson.name" : "Crimson"
"role.crimson.short" : "Crm"
"role.crimson.blurb" : "Some things are only for you."
"role.crimson.doc" : "During meetings you can <b>open a private channel</b> between any two players (you silently watch it), or send an <b>anonymous whisper</b> to someone. Both are typed into the normal chat box."
"role.crimson.generalBlurb" : "Some things are only for you."
"options.role.crimson.detail" : "The Crimson controls the flow of private information during meetings."
"options.modifier.crimson.detail" : "The Crimson controls the flow of private information during meetings."
"role.jade.name" : "Jade"
"role.jade.short" : "Jd"
"role.jade.blurb" : "Rather shattered jade than whole tile."
"role.jade.doc" : "Cast <b>Gem Shield</b> to give everyone a temporary one-time shield. <b>You never see it break</b> — only that it worked."
"role.jade.generalBlurb" : "Rather shattered jade than whole tile."
"options.role.jade.detail" : "The Jade shields everyone once, blind to who was saved."
"options.modifier.jade.detail" : "The Jade shields everyone once, blind to who was saved."
"role.polygraph.name" : "Polygraph"
"role.polygraph.short" : "Ply"
"role.polygraph.blurb" : "Let's see whether you're telling the truth."
"role.polygraph.doc" : "In a meeting, click a player to select them, then <b>click them again</b> for a role test, or <b>click someone else</b> to ask whether they killed that person. The answer is only yes or no."
"role.polygraph.generalBlurb" : "Let's see whether you're telling the truth."
"options.role.polygraph.detail" : "The Polygraph matches a player against a role or a killing and gets yes/no."
"options.modifier.polygraph.detail" : "The Polygraph matches a player against a role or a killing and gets yes/no."
"role.agent007.name" : "Agent 007"
"role.agent007.short" : "007"
"role.agent007.blurb" : "Patience."
"role.agent007.doc" : "Plant a <b>foreshadow</b> on a target: they die after a set number of rounds and <b>get a warning one round before</b>."
"role.agent007.generalBlurb" : "Patience."
"options.role.agent007.detail" : "Agent 007 replaces direct kills with delayed deaths."
"options.modifier.agent007.detail" : "Agent 007 replaces direct kills with delayed deaths."
"role.coder.name" : "Coder"
"role.coder.short" : "Cdr"
"role.coder.blurb" : "One bug is a bug; a pile of bugs is a feature."
"role.coder.doc" : "During meetings, <b>plant a bug</b> on a player: <b>their next kill fails</b> and immediately goes on cooldown."
"role.coder.generalBlurb" : "One bug is a bug; a pile of bugs is a feature."
"options.role.coder.detail" : "The Coder cancels one of an opponent's abilities."
"options.modifier.coder.detail" : "The Coder cancels one of an opponent's abilities."
"role.owl.name" : "Owl"
"role.owl.short" : "Owl"
"role.owl.blurb" : "The people of the night serve me!"
"role.owl.doc" : "Hypnotize a player: they gain a <b>one-shot knife</b> and count as an Impostor. They <b>die if they don't use it</b>, and you can <b>devour</b> them at any time."
"role.owl.generalBlurb" : "The people of the night serve me!"
"options.role.owl.detail" : "The Owl turns crewmates into single-use weapons."
"options.modifier.owl.detail" : "The Owl turns crewmates into single-use weapons."
"role.sweeper.name" : "Sweeper"
"role.sweeper.short" : "Swp"
"role.sweeper.blurb" : "Here's a spinning gift for you!"
"role.sweeper.doc" : "Place the airflow device, then <b>activate</b> it to spawn a tornado. <b>Everyone inside dies.</b> <b>One use only</b> — afterwards you're a plain Impostor."
"role.sweeper.generalBlurb" : "Here's a spinning gift for you!"
"options.role.sweeper.detail" : "The Sweeper gets one area wipe."
"options.modifier.sweeper.detail" : "The Sweeper gets one area wipe."
"role.wrecker.name" : "Wrecker"
"role.wrecker.short" : "Wrk"
"role.wrecker.blurb" : "Sabotage is my home turf!"
"role.wrecker.doc" : "While a sabotage is active your <b>kill cooldown keeps shrinking</b>, dropping further with each kill (down to a floor). <b>Everything resets when the sabotage ends.</b>"
"role.wrecker.generalBlurb" : "Sabotage is my home turf!"
"options.role.wrecker.detail" : "The Wrecker turns sabotages into harvest windows."
"options.modifier.wrecker.detail" : "The Wrecker turns sabotages into harvest windows."
"role.recidivist.name" : "Recidivist"
"role.recidivist.short" : "Rcd"
"role.recidivist.blurb" : "Corpses everywhere — I'm used to it."
"role.recidivist.doc" : "Every kill randomly triggers one effect: <b>body cleanup / haste / instant reset / misfire / blunt blade / nothing</b>."
"role.recidivist.generalBlurb" : "Corpses everywhere — I'm used to it."
"options.role.recidivist.detail" : "Every Recidivist kill is a loot box."
"options.modifier.recidivist.detail" : "Every Recidivist kill is a loot box."
"role.cinnabar.name" : "Cinnabar"
"role.cinnabar.short" : "Cin"
"role.cinnabar.blurb" : "A lethal love-poison."
"role.cinnabar.doc" : "<b>Mark</b> crewmates to turn them into Cinnabarred, bound to you one-way. You can <b>kill them all at will</b>, and <b>they die of poison if you fall</b>."
"role.cinnabar.generalBlurb" : "A lethal love-poison."
"options.role.cinnabar.detail" : "The Cinnabar holds crewmates hostage through a bond."
"options.modifier.cinnabar.detail" : "The Cinnabar holds crewmates hostage through a bond."
"role.compulsion.name" : "Compulsion"
"role.compulsion.short" : "Cmp"
"role.compulsion.blurb" : "I cannot stand a single gap!"
"role.compulsion.doc" : "Each meeting has a chance to <b>trigger</b>. If the vote isn't unanimous that round, <b>the minority dies once the meeting ends</b>. It can also backfire on you."
"role.compulsion.generalBlurb" : "I cannot stand a single gap!"
"options.role.compulsion.detail" : "Compulsion turns an untidy vote into a massacre."
"options.modifier.compulsion.detail" : "Compulsion turns an untidy vote into a massacre."
"role.anesthetist.name" : "Anesthetist"
"role.anesthetist.short" : "Ans"
"role.anesthetist.blurb" : "There, there — the needle only stings a moment."
"role.anesthetist.doc" : "Your kill is replaced by <b>Anesthesia</b>. Victims move inverted <b>after the meeting</b> and <b>die the moment they report a body</b>. Each use permanently lengthens your cooldown."
"role.anesthetist.generalBlurb" : "There, there — the needle only stings a moment."
"options.role.anesthetist.detail" : "The Anesthetist never spills blood — the victim presses report themselves."
"options.modifier.anesthetist.detail" : "The Anesthetist never spills blood — the victim presses report themselves."
"role.toxin.name" : "Toxin"
"role.toxin.short" : "Tox"
"role.toxin.blurb" : "Venom is merely my canvas."
"role.toxin.doc" : "<b>Each kill unlocks a poison.</b> A poisoned crewmate's next ability is <b>guaranteed to kill its target</b>, and they take the blame — a Sheriff will gun down a crewmate."
"role.toxin.generalBlurb" : "Venom is merely my canvas."
"options.role.toxin.detail" : "The Toxin makes the good guys do the killing."
"options.modifier.toxin.detail" : "The Toxin makes the good guys do the killing."
"role.wraith.name" : "Artificial Wraith"
"role.wraith.short" : "Wrt"
"role.wraith.blurb" : "I've come to collect."
"role.wraith.doc" : "Leave your body to enter <b>soul form</b>: invisible, faster and <b>immune to kills</b>. While out, <b>possess</b> someone to give them a 3-second-cooldown knife. You return automatically."
"role.wraith.generalBlurb" : "I've come to collect."
"options.role.wraith.detail" : "The Artificial Wraith kills through other people's hands."
"options.modifier.wraith.detail" : "The Artificial Wraith kills through other people's hands."
"role.caterpillar.name" : "Caterpillar"
"role.caterpillar.short" : "Cat"
"role.caterpillar.blurb" : "Meow meow meow."
"role.caterpillar.doc" : "Your ability turns <b>everyone into caterpillars</b>. While transformed you can <b>swallow</b> people, leaving no body. Eat enough and you <b>win alone</b>."
"role.caterpillar.generalBlurb" : "Meow meow meow."
"options.role.caterpillar.detail" : "The Caterpillar feeds during the chaos of mass transformation."
"options.modifier.caterpillar.detail" : "The Caterpillar feeds during the chaos of mass transformation."
"role.fanatic.name" : "Fanatic"
"role.fanatic.short" : "Fan"
"role.fanatic.blurb" : "I'll follow you to the very last moment."
"role.fanatic.doc" : "Pick someone to <b>follow</b> at the start; following unlocks a knife. Keep them alive — <b>they never learn you follow them</b>."
"role.fanatic.generalBlurb" : "I'll follow you to the very last moment."
"options.role.fanatic.detail" : "The Fanatic fights for a stranger."
"options.modifier.fanatic.detail" : "The Fanatic fights for a stranger."
"role.treasureHunter.name" : "Treasure Hunter"
"role.treasureHunter.short" : "Trs"
"role.treasureHunter.blurb" : "This ship is full of treasures."
"role.treasureHunter.doc" : "<b>Mounds</b> are scattered across the ship. Stand next to one and dig. <b>Finding the treasure wins instantly.</b>"
"role.treasureHunter.generalBlurb" : "This ship is full of treasures."
"options.role.treasureHunter.detail" : "The Treasure Hunter doesn't care who dies — only what's buried."
"options.modifier.treasureHunter.detail" : "The Treasure Hunter doesn't care who dies — only what's buried."
"role.madman.name" : "Madman"
"role.madman.short" : "Mad"
"role.madman.blurb" : "You're the truly mad ones."
"role.madman.doc" : "You <b>know everyone's role</b>, but <b>your vote counts for nothing</b> and you can hold no sub-roles. Survive to the end and <b>steal the fools' victory</b>."
"role.madman.generalBlurb" : "You're the truly mad ones."
"options.role.madman.detail" : "The Madman sees everything and counts for nothing."
"options.modifier.madman.detail" : "The Madman sees everything and counts for nothing."
"role.reveler.name" : "Reveler"
"role.reveler.short" : "Rvl"
"role.reveler.blurb" : "What is joy? I am joy!"
"role.reveler.doc" : "Stand next to a task console to <b>sabotage it</b> (the targeted console is outlined).<br>The <b>first person to do a task at that console dies</b>; each trap works once.<br>Win by engineering enough deaths."
"role.reveler.generalBlurb" : "What is joy? I am joy!"
"options.role.reveler.detail" : "The Reveler turns task consoles into traps. Whoever does a task there dies."
"options.modifier.reveler.detail" : "The Reveler turns task spots into traps."
"role.plumber.name" : "Plumber"
"role.plumber.short" : "Plm"
"role.plumber.blurb" : "My name is Mario."
"role.plumber.doc" : "Dive into a pipe to spend time <b>outside the map</b>. <b>Everyone knows you exist from the start</b>, and <b>nobody can win while you live</b>. If you're killed with only three left, <b>everyone wins together</b>."
"role.plumber.generalBlurb" : "My name is Mario."
"options.role.plumber.detail" : "The Plumber is the nail everyone must pull first."
"options.modifier.plumber.detail" : "The Plumber is the nail everyone must pull first."
"role.vindicator.name" : "Vindicator"
"role.vindicator.short" : "Vnd"
"role.vindicator.blurb" : "How could you kill me..."
"role.vindicator.doc" : "Killed during the free phase, your <b>body vanishes</b>. Next free phase you rise <b>enraged</b>: you know the killer's position, cannot call meetings, and must avenge yourself in time. <b>Kill the wrong person and the killer's faction wins</b>; time out and you die."
"role.vindicator.generalBlurb" : "How could you kill me..."
"options.role.vindicator.detail" : "The Vindicator trades a death for one shot at revenge."
"options.modifier.vindicator.detail" : "The Vindicator trades a death for one shot at revenge."
"role.artist.name" : "Artist"
"role.artist.short" : "Art"
"role.artist.blurb" : "I believe I can paint the finest picture."
"role.artist.doc" : "Gift <b>paintings</b> to players. Once the living count drops to the threshold, every holder <b>becomes your Admirer</b> and wins with you."
"role.artist.generalBlurb" : "I believe I can paint the finest picture."
"options.role.artist.detail" : "The Artist buys loyalty with artwork."
"options.modifier.artist.detail" : "The Artist buys loyalty with artwork."
"role.savior.name" : "Savior"
"role.savior.short" : "Sav"
"role.savior.blurb" : "Saving you was nothing."
"role.savior.doc" : "Stand by a corpse to <b>revive</b> it. The revived become <b>Rescued</b> and win with you — but <b>they die when you die</b>, and their death refunds a use.<br>During the free phase you can use <b>Insight</b> on a player and learn <b>%NUM%</b> candidate roles at the start of the next meeting, <b>one of which is always their true role</b>.<br>In meetings you can also <b>mark</b> someone as the role you believe them to be; only you and your Rescued can see it."
"role.savior.generalBlurb" : "Saving you was nothing."
"options.role.savior.detail" : "The Savior wins by collecting the living."
"options.modifier.savior.detail" : "The Savior wins by collecting the living."
"role.strayer.name" : "Strayer"
"role.strayer.short" : "Str"
"role.strayer.blurb" : "I strayed from the path."
"role.strayer.doc" : "You appear as an <b>Agent</b>, even to yourself. Completing every task <b>awakens</b> you and unlocks a one-shot knife. <b>Win by being exiled the same round you kill</b>; survive it and you drop dead when the meeting ends."
"role.strayer.generalBlurb" : "I strayed from the path."
"options.role.strayer.detail" : "The Strayer must first prove themselves, then destroy themselves."
"options.modifier.strayer.detail" : "The Strayer must first prove themselves, then destroy themselves."
"role.pureWhite.name" : "Pure White"
"role.pureWhite.short" : "Pw"
"role.pureWhite.blurb" : "You can only take on another's colour."
"role.pureWhite.doc" : "Use <b>Tint</b> to join a player's faction; your knife <b>unlocks only after joining</b>. You see their role, but <b>they never see you</b>. You win when they win."
"role.pureWhite.generalBlurb" : "You can only take on another's colour."
"options.role.pureWhite.detail" : "Pure White has no colour of its own — only borrowed ones."
"options.modifier.pureWhite.detail" : "Pure White has no colour of its own — only borrowed ones."
"role.boss.name" : "Boss"
"role.boss.short" : "Bss"
"role.boss.blurb" : "Come work for me — room and board included!"
"role.boss.doc" : "<b>Hire</b> a player to instantly turn them into a Workaholic, losing their old role. <b>Hiring an Impostor wastes the use.</b> Once a Workaholic's salary is high enough, you <b>steal the victory</b> from whichever faction meets its condition. <b>When the last Workaholic dies, so do you.</b>"
"role.boss.generalBlurb" : "Come work for me — room and board included!"
"options.role.boss.detail" : "The Boss books other people's victories as revenue."
"options.modifier.boss.detail" : "The Boss books other people's victories as revenue."
"role.workaholic.name" : "Workaholic"
"role.workaholic.short" : "Wkh"
"role.workaholic.blurb" : "Think you can pull another 999 hours?"
"role.workaholic.doc" : "Tasks earn <b>salary</b>: +100 each. Your salary <b>burns down every minute</b> (meetings don't count), and <b>hitting zero kills you</b>. A high enough salary lets your Boss steal the win."
"role.workaholic.generalBlurb" : "Think you can pull another 999 hours?"
"options.role.workaholic.detail" : "The Workaholic survives only by never stopping."
"options.modifier.workaholic.detail" : "The Workaholic survives only by never stopping."

