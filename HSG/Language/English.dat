"achievement.maskedDancer.suicide.goal" : "The Masked Dancer dies at the party."

"role.forbiddenLove.name" : "Forbidden Love"
"role.forbiddenLove.short" : "Love"
"role.forbiddenLove.blurb" : "I will stay with you until the very end"
"role.forbiddenLove.doc" : "You are a special chain.<b>All knife-wielding roles can see you</b>, and you cannot win with any faction — you can only evade pursuit together and survive to the end to <b>win independently</b>."
"role.forbiddenLove.generalBlurb" : "I will stay with you until the very end"
"options.role.forbiddenLove.detail" : "A paired neutral chain, known to all knife-wielding roles, who must both survive to win."
"options.modifier.forbiddenLove.detail" : "A paired neutral chain, known to all knife-wielding roles, who must both survive to win."
"role.fervor.name" : "Fervor"
"role.fervor.short" : "Ferv"
"role.fervor.blurb" : "One more time!"
"role.fervor.doc" : "Once per cooldown cycle, you can act <b>twice</b> — the first use follows normal cooldown, and the immediately following cooldown is reduced to zero."
"role.fervor.generalBlurb" : "One more time!"
"options.role.fervor.detail" : "Allows the holder to use skills or kills twice per cooldown cycle."
"options.modifier.fervor.detail" : "Allows the holder to use skills or kills twice per cooldown cycle."
"role.smokescreen.name" : "Smokescreen"
"role.smokescreen.short" : "Smoke"
"role.smokescreen.blurb" : "You can't see me"
"role.smokescreen.doc" : "In meetings, <b>cannot be affected by skills</b>: immune to guessing, interrogation, and any in-meeting kill skills."
"role.smokescreen.generalBlurb" : "You can't see me"
"options.role.smokescreen.detail" : "Makes the holder immune to all targeted skills during meetings."
"options.modifier.smokescreen.detail" : "Makes the holder immune to all targeted skills during meetings."
"role.servant.name" : "Servant"
"role.servant.short" : "Serv"
"role.servant.blurb" : "I'll do as told"
"role.servant.doc" : "You have been recruited by the Plantation Owner. Try to complete tasks for him; <b>when the Plantation Owner dies, you revert to your original role</b>."
"role.servant.generalBlurb" : "I'll do as told"
"options.role.servant.detail" : "A modifier role created by the Plantation Owner's recruitment."
"options.modifier.servant.detail" : "A modifier role created by the Plantation Owner's recruitment."
"role.crowned.name" : "Crowned"
"role.crowned.short" : "Crown"
"role.crowned.blurb" : "Thank you, Your Majesty"
"role.crowned.doc" : "You have been crowned by the King, giving you <b>an extra vote</b> in meetings; when the King is killed, <b>you die in his place</b>."
"role.crowned.generalBlurb" : "Thank you, Your Majesty"
"options.role.crowned.detail" : "A modifier role created by the King's coronation."
"options.modifier.crowned.detail" : "A modifier role created by the King's coronation."
"role.hypnotized.name" : "Hypnotized"
"role.hypnotized.short" : "Hyp"
"role.hypnotized.blurb" : "My body won't listen to me"
"role.hypnotized.doc" : "You have been hypnotized by the Owl: you gain a <b>one-time knife</b> and count as an Impostor for numbers. After using the knife, you return to normal; <b>if you don't use the knife, you die when time runs out</b>. The Owl can use Soul Devour to kill you at any time."
"role.hypnotized.generalBlurb" : "My body won't listen to me"
"options.role.hypnotized.detail" : "A modifier role created by the Owl's hypnosis."
"options.modifier.hypnotized.detail" : "A modifier role created by the Owl's hypnosis."
"role.cinnabarred.name" : "Cinnabar-Marked"
"role.cinnabarred.short" : "Cin"
"role.cinnabarred.blurb" : "What is this feeling..."
"role.cinnabarred.doc" : "You have been marked by Cinnabar, forming a <b>one-way chain</b> with them. You can see the heart between you and Cinnabar. <b>When Cinnabar dies, you die of poison</b>, but as long as you live, you can win with Cinnabar."
"role.cinnabarred.generalBlurb" : "What is this feeling..."
"options.role.cinnabarred.detail" : "A modifier role created by Cinnabar's marking."
"options.modifier.cinnabarred.detail" : "A modifier role created by Cinnabar's marking."
"role.rescued.name" : "Rescued"
"role.rescued.short" : "Resc"
"role.rescued.blurb" : "I never thought I'd meet such a good person"
"role.rescued.doc" : "Your savior pulled you back from death. You <b>win with your savior</b>, but <b>if they die, you die too</b>. You receive a notification when someone on the field dies."
"role.rescued.generalBlurb" : "I never thought I'd meet such a good person"
"options.role.rescued.detail" : "A modifier role created by the Savior's revival."
"options.modifier.rescued.detail" : "A modifier role created by the Savior's revival."
"role.admirer.name" : "Fan"
"role.admirer.short" : "Fan"
"role.admirer.blurb" : "This painting is beautiful"
"role.admirer.doc" : "You accepted the Artist's painting, and now <b>stand on the same side</b> as them, winning with the Artist."
"role.admirer.generalBlurb" : "This painting is beautiful"
"options.role.admirer.detail" : "A modifier role created by the Artist's gift."
"options.modifier.admirer.detail" : "A modifier role created by the Artist's gift."
"role.gemShield.name" : "Gem Shield"
"role.gemShield.short" : "Shield"
"role.gemShield.blurb" : "Rather shatter than yield"
"role.gemShield.doc" : "Jade has given you a <b>one-time shield</b> that blocks one kill, with a limited duration."
"role.gemShield.generalBlurb" : "Rather shatter than yield"
"options.role.gemShield.detail" : "A modifier role granted by Jade."
"options.modifier.gemShield.detail" : "A modifier role granted by Jade."
"role.bugged.name" : "Bugged"
"role.bugged.short" : "Bug"
"role.bugged.blurb" : "What's going on?"
"role.bugged.doc" : "The Coder planted a bug on you: <b>your next kill will fail</b> and immediately go on cooldown."
"role.bugged.generalBlurb" : "What's going on?"
"options.role.bugged.detail" : "A modifier role planted by the Coder."
"options.modifier.bugged.detail" : "A modifier role planted by the Coder."
"role.poisoned.name" : "Poisoned"
"role.poisoned.short" : "Pois"
"role.poisoned.blurb" : "My blood is burning"
"role.poisoned.doc" : "The Toxin Killer has poisoned you: <b>your next skill use will definitely kill the target</b>, and the blame falls on you."
"role.poisoned.generalBlurb" : "My blood is burning"
"options.role.poisoned.detail" : "A modifier role created by the Toxin Killer's poison."
"options.modifier.poisoned.detail" : "A modifier role created by the Toxin Killer's poison."
"role.possessed.name" : "Possessed"
"role.possessed.short" : "Poss"
"role.possessed.blurb" : "Something has crawled inside"
"role.possessed.doc" : "An Artificial Wraith has possessed you. During possession, you have a knife with only a <b>3-second cooldown</b>."
"role.possessed.generalBlurb" : "Something has crawled inside"
"options.role.possessed.detail" : "A modifier role created by the Artificial Wraith's possession."
"options.modifier.possessed.detail" : "A modifier role created by the Artificial Wraith's possession."
"role.anesthetized.name" : "Anesthetized"
"role.anesthetized.short" : "Anes"
"role.anesthetized.blurb" : "So dizzy..."
"role.anesthetized.doc" : "You have been anesthetized. <b>After the meeting ends</b>, your movement controls are inverted, and <b>you will die if you report a body or call a meeting</b>."
"role.anesthetized.generalBlurb" : "So dizzy..."
"options.role.anesthetized.detail" : "A modifier role applied by the Anesthetist."
"options.modifier.anesthetized.detail" : "A modifier role applied by the Anesthetist."
"role.count.name" : "Count"
"role.count.short" : "Cnt"
"role.count.blurb" : "My will shall be passed on forever"
"role.count.doc" : "You carry an extra <b>inheritance task</b>. If you die after completing all tasks, <b>you will revive on the spot next round as the Heir</b>. The Heir can <b>execute any one person</b> in a meeting."
"role.count.generalBlurb" : "My will shall be passed on forever"
"options.role.count.detail" : "The Count can revive as the Heir after completing tasks and dying, gaining meeting execution power."
"options.modifier.count.detail" : "The Count can revive as the Heir after completing tasks and dying, gaining meeting execution power."
"role.giver.name" : "Giver"
"role.giver.short" : "Give"
"role.giver.blurb" : "I have everything you need"
"role.giver.doc" : "After selecting a player, you can choose a role from random candidates and grant that role's <b>one-time skill</b> to them. Their role remains unchanged.<br>The skill expires after one use; passive or meeting-based skills last until the end of the next meeting.<br><b>Giving to an Impostor kills you on the spot</b>, and uses are limited."
"role.giver.generalBlurb" : "I have everything you need"
"options.role.giver.detail" : "The Giver can give other roles' one-time skills to crewmates, but giving to the wrong person costs their life."
"options.modifier.giver.detail" : "The Giver can give other roles to crewmates, but giving to the wrong person costs their life."
"role.hunter.name" : "Hunter"
"role.hunter.short" : "Hunt"
"role.hunter.blurb" : "An eye for an eye, a tooth for a tooth"
"role.hunter.doc" : "In meetings, you can designate a suspect. <b>When voted out, you take them with you</b>."
"role.hunter.generalBlurb" : "An eye for an eye, a tooth for a tooth"
"options.role.hunter.detail" : "The Hunter can take a suspect with them when voted out."
"options.modifier.hunter.detail" : "The Hunter can take a suspect with them when voted out."
"role.plantation.name" : "Plantation Owner"
"role.plantation.short" : "Plant"
"role.plantation.blurb" : "Get to work, my servants"
"role.plantation.doc" : "You <b>cannot complete tasks yourself</b>, but you have a task quota. Recruit servants to do tasks for you; <b>if the quota isn't met within the round limit, you die</b>."
"role.plantation.generalBlurb" : "Get to work, my servants"
"options.role.plantation.detail" : "The Plantation Owner relies on recruited servants to complete tasks and dies if time runs out."
"options.modifier.plantation.detail" : "The Plantation Owner relies on recruited servants to complete tasks and dies if time runs out."
"role.king.name" : "King"
"role.king.short" : "King"
"role.king.blurb" : "How do you do, my subjects?"
"role.king.doc" : "Crown a <b>crewmate</b> to give them an extra vote; <b>crowning a non-crewmate causes you to be assassinated</b>. When you are killed, the crowned player dies in your place; after the crowned player dies, you become <b>revealed and immune to guessing</b>, and can crown again."
"role.king.generalBlurb" : "How do you do, my subjects?"
"options.role.king.detail" : "The King crowns a crewmate in exchange for a death substitute and double vote, but crowning the wrong person kills him on the spot."
"options.modifier.king.detail" : "The King crowns a crewmate in exchange for a death substitute and double vote, but crowning the wrong person kills him on the spot."
"role.discerner.name" : "Discerner"
"role.discerner.short" : "Disc"
"role.discerner.blurb" : "Seeing through evil intentions"
"role.discerner.doc" : "Mark a player. <b>If they draw a knife while the mark is active, you receive a notification</b> and your cooldown is refreshed; if the mark expires without a hit, it is cleared and <b>your cooldown is increased</b>."
"role.discerner.generalBlurb" : "Seeing through evil intentions"
"options.role.discerner.detail" : "The Discerner marks players; hitting a knife-drawer refreshes cooldown, missing incurs a penalty."
"options.modifier.discerner.detail" : "The Discerner marks players; hitting a knife-drawer refreshes cooldown, missing incurs a penalty."
"role.tofuLover.name" : "Tofu Enthusiast"
"role.tofuLover.short" : "Tofu"
"role.tofuLover.blurb" : "Everything for tofu!"
"role.tofuLover.doc" : "You can eat <b>the Fox's tofu</b> on the map. Each plate restores 1 point of satiety (about %SEC% seconds); while satiety lasts, you can use the Fox's <b>Vanish</b>. <b>Zero satiety does not kill you</b>, it just disables the skill. Note: every plate you eat is one less plate for the Fox."
"role.tofuLover.generalBlurb" : "Everything for tofu!"
"options.role.tofuLover.detail" : "The Tofu Enthusiast temporarily gains the Fox's skills by stealing the Fox's tofu. <b>The Fox must be enabled in the room for tofu to exist.</b>"
"role.ultramarine.name" : "Ultramarine"
"role.ultramarine.short" : "Ultra"
"role.ultramarine.blurb" : "Let me depict light and shadow for you."
"role.ultramarine.doc" : "In meetings, use <b>Depict</b> on a player to publicly reveal their faction in a <b>two-choice</b> format (Black / White / Grey). The result lasts for one meeting only."
"role.ultramarine.generalBlurb" : "Let me depict light and shadow for you."
"options.role.ultramarine.detail" : "Ultramarine publicly reveals a two-choice clue about a player's faction in meetings."
"options.modifier.ultramarine.detail" : "Ultramarine publicly reveals a two-choice clue about a player's faction in meetings."
"role.ochre.name" : "Ochre"
"role.ochre.short" : "Ochre"
"role.ochre.blurb" : "Dyeing all the mountains"
"role.ochre.doc" : "<b>Dye</b> a player, letting them see a random player of the same faction — the two become <b>close friends</b>, able to see each other but not you. All Neutrals are considered the same side."
"role.ochre.generalBlurb" : "Dyeing all the mountains"
"options.role.ochre.detail" : "Ochre connects players, letting same-faction people recognize each other."
"options.modifier.ochre.detail" : "Ochre connects players, letting same-faction people recognize each other."
"role.crimson.name" : "Crimson"
"role.crimson.short" : "Crim"
"role.crimson.blurb" : "Some things I only want to say to you"
"role.crimson.doc" : "In meetings, you can <b>open a private channel</b> for any two people (you can observe all content), or select one person to send an <b>anonymous whisper</b>. Both skills are <b>used directly by typing in the chat box</b>."
"role.crimson.generalBlurb" : "Some things I only want to say to you"
"options.role.crimson.detail" : "Crimson can manipulate the private information flow in meetings."
"options.modifier.crimson.detail" : "Crimson can manipulate the private information flow in meetings."
"role.jade.name" : "Jade"
"role.jade.short" : "Jade"
"role.jade.blurb" : "Rather shatter than yield"
"role.jade.doc" : "Use <b>Gem Shield</b> to give everyone on the field a timed one-time shield. <b>You cannot see the shield-break effect yourself</b>, only that the shield has been active."
"role.jade.generalBlurb" : "Rather shatter than yield"
"options.role.jade.detail" : "Jade gives everyone a one-time shield but cannot see who is protected."
"options.modifier.jade.detail" : "Jade gives everyone a one-time shield but cannot see who is protected."
"role.polygraph.name" : "Polygraph"
"role.polygraph.short" : "Poly"
"role.polygraph.blurb" : "Let me see if what you say is true"
"role.polygraph.doc" : "In meetings, first click a person to select a target, <b>then click yourself</b> to do a role polygraph, or <b>click someone else</b> to ask \"Did he kill this person?\". The answer is only Yes or No."
"role.polygraph.generalBlurb" : "Let me see if what you say is true"
"options.role.polygraph.detail" : "The Polygraph can verify a player against a role or a kill fact."
"options.modifier.polygraph.detail" : "The Polygraph can verify a player against a role or a kill fact."
"role.agent007.name" : "Agent 007"
"role.agent007.short" : "007"
"role.agent007.blurb" : "Hold your horses"
"role.agent007.doc" : "<b>Plant foreshadowing</b> on the target; they will die after a specified number of rounds, <b>receiving a warning one round before death</b>."
"role.agent007.generalBlurb" : "Hold your horses"
"options.role.agent007.detail" : "Agent 007 uses delayed death instead of direct knifing."
"options.modifier.agent007.detail" : "Agent 007 uses delayed death instead of direct knifing."
"role.coder.name" : "Coder"
"role.coder.short" : "Code"
"role.coder.blurb" : "One bug is a bug, a bunch of bugs is a feature"
"role.coder.doc" : "During the meeting phase, <b>plant a bug</b> on a player: <b>their next kill will fail</b> and immediately go on cooldown."
"role.coder.generalBlurb" : "One bug is a bug, a bunch of bugs is a feature"
"options.role.coder.detail" : "The Coder can disable an opponent's skill once."
"options.modifier.coder.detail" : "The Coder can disable an opponent's skill once."
"role.owl.name" : "Owl"
"role.owl.short" : "Owl"
"role.owl.blurb" : "The people of the night serve me!"
"role.owl.doc" : "Hypnotize a player; they gain a <b>one-time knife</b> and count as an Impostor for numbers. The hypnotized player <b>dies if they don't use the knife</b>, and you can also use <b>Soul Devour</b> to kill them at any time."
"role.owl.generalBlurb" : "The people of the night serve me!"
"options.role.owl.detail" : "The Owl turns crewmates into one-time knives."
"options.modifier.owl.detail" : "The Owl turns crewmates into one-time knives."
"role.sweeper.name" : "Sweeper"
"role.sweeper.short" : "Sweep"
"role.sweeper.blurb" : "Here's a spinning gift for you!"
"role.sweeper.doc" : "First place an airflow device, then <b>activate</b> it to create a tornado. <b>Everyone within range dies</b>. This skill <b>can only be used once</b>; after use, you become a normal Impostor."
"role.sweeper.generalBlurb" : "Here's a spinning gift for you!"
"options.role.sweeper.detail" : "The Sweeper has one chance at an area clear."
"options.modifier.sweeper.detail" : "The Sweeper has one chance at an area clear."
"role.wrecker.name" : "Wrecker"
"role.wrecker.short" : "Wreck"
"role.wrecker.blurb" : "Sabotage is my home turf!"
"role.wrecker.doc" : "During sabotages, your <b>kill cooldown continuously decreases</b>, with each kill reducing it another step (with a floor). <b>All effects are cleared after the sabotage ends</b>."
"role.wrecker.generalBlurb" : "Sabotage is my home turf!"
"options.role.wrecker.detail" : "The Wrecker turns sabotage time into harvest time."
"options.modifier.wrecker.detail" : "The Wrecker turns sabotage time into harvest time."
"role.recidivist.name" : "Recidivist"
"role.recidivist.short" : "Recid"
"role.recidivist.blurb" : "Fields of corpses are nothing new to me"
"role.recidivist.doc" : "Each kill randomly triggers an effect: <b>Destroy Evidence / Bloodlust Overflow / Endless / Occasional Miss / My Knife Is Dull / Nothing Happens</b>."
"role.recidivist.generalBlurb" : "Fields of corpses are nothing new to me"
"options.role.recidivist.detail" : "Every kill of the Recidivist is a loot box."
"options.modifier.recidivist.detail" : "Every kill of the Recidivist is a loot box."
"role.cinnabar.name" : "Cinnabar"
"role.cinnabar.short" : "Cin"
"role.cinnabar.blurb" : "Deadly love poison."
"role.cinnabar.doc" : "<b>Mark</b> a crewmate to make them Cinnabar-Marked, forming a one-way chain with you. You can <b>kill all Cinnabar-Marked at any time</b>; <b>if you die, they die of poison too</b>."
"role.cinnabar.generalBlurb" : "Deadly love poison."
"options.role.cinnabar.detail" : "Cinnabar uses chains to turn crewmates into hostages."
"options.modifier.cinnabar.detail" : "Cinnabar uses chains to turn crewmates into hostages."
"role.compulsion.name" : "OCD"
"role.compulsion.short" : "OCD"
"role.compulsion.blurb" : "I can't stand any gaps!"
"role.compulsion.doc" : "Each meeting has a chance to <b>trigger</b>. On a triggered round, if the vote is not unanimous, <b>the side with fewer votes dies after the meeting ends</b>. There is also a small chance it backfires on you."
"role.compulsion.generalBlurb" : "I can't stand any gaps!"
"options.role.compulsion.detail" : "OCD turns messy voting into a massacre."
"options.modifier.compulsion.detail" : "OCD turns messy voting into a massacre."
"role.anesthetist.name" : "Anesthetist"
"role.anesthetist.short" : "Anes"
"role.anesthetist.blurb" : "Be good, endure the needle's pain"
"role.anesthetist.doc" : "Kills are replaced with <b>Anesthesia</b>. The anesthetized player's movement controls are inverted <b>after the meeting</b>, and <b>they die if they report a body</b>. Cooldown increases permanently with each use."
"role.anesthetist.generalBlurb" : "Be good, endure the needle's pain"
"options.role.anesthetist.detail" : "The Anesthetist kills without blood, waiting for the target to press report themselves."
"options.modifier.anesthetist.detail" : "The Anesthetist kills without blood, waiting for the target to press report themselves."
"role.toxin.name" : "Toxin Killer"
"role.toxin.short" : "Tox"
"role.toxin.blurb" : "Venom is just my artwork"
"role.toxin.doc" : "<b>Each kill unlocks one poison use</b>. The poisoned crewmate's next skill <b>will definitely kill the target</b>, and the blame falls on them — the Sheriff will shoot the crewmate because of this."
"role.toxin.generalBlurb" : "Venom is just my artwork"
"options.role.toxin.detail" : "The Toxin Killer makes good people do the deed for them."
"options.modifier.toxin.detail" : "The Toxin Killer makes good people do the deed for them."
"role.wraith.name" : "Artificial Wraith"
"role.wraith.short" : "Wraith"
"role.wraith.blurb" : "I've come for your soul!"
"role.wraith.doc" : "Use the skill <b>Soul Departure</b>: during it, you are invisible, faster, and <b>immune to kills</b>. You can choose a person to <b>possess</b>, giving them a knife with only a 3-second cooldown. You automatically return when time is up."
"role.wraith.generalBlurb" : "I've come for your soul!"
"options.role.wraith.detail" : "The Artificial Wraith kills through others' hands."
"options.modifier.wraith.detail" : "The Artificial Wraith kills through others' hands."
"role.caterpillar.name" : "Kitty Caterpillar"
"role.caterpillar.short" : "Kitty"
"role.caterpillar.blurb" : "Meow meow meow"
"role.caterpillar.doc" : "Use the skill to <b>turn everyone into kitty caterpillars</b>. During the transformation, you can <b>swallow others</b> (leaving no body). Swallow the required number of people to <b>win independently</b>."
"role.caterpillar.generalBlurb" : "Meow meow meow"
"options.role.caterpillar.detail" : "The Kitty Caterpillar eats people in the chaos of transformation to win."
"options.modifier.caterpillar.detail" : "The Kitty Caterpillar eats people in the chaos of transformation to win."
"role.fanatic.name" : "Fanatic"
"role.fanatic.short" : "Fan"
"role.fanatic.blurb" : "I will follow you to the very end"
"role.fanatic.doc" : "At the start, choose a player to <b>follow</b>; following unlocks a knife. Help them survive to the end — <b>the followed player does not know you are following them</b>."
"role.fanatic.generalBlurb" : "I will follow you to the very end"
"options.role.fanatic.detail" : "The Fanatic fights for a complete stranger."
"options.modifier.fanatic.detail" : "The Fanatic fights for a complete stranger."
"role.treasureHunter.name" : "Treasure Hunter"
"role.treasureHunter.short" : "Treasure"
"role.treasureHunter.blurb" : "There are many treasures on this ship"
"role.treasureHunter.doc" : "Many <b>small dirt piles</b> are scattered on the ship. Walk up to a pile and dig it open. <b>Finding a treasure wins immediately</b>."
"role.treasureHunter.generalBlurb" : "There are many treasures on this ship"
"options.role.treasureHunter.detail" : "The Treasure Hunter doesn't care who lives or dies, only about digging something up."
"options.modifier.treasureHunter.detail" : "The Treasure Hunter doesn't care who lives or dies, only about digging something up."
"role.madman.name" : "Madman"
"role.madman.short" : "Mad"
"role.madman.blurb" : "You're the crazy ones"
"role.madman.doc" : "You <b>know everyone's identity</b>, but <b>your votes are invalid</b>, and you cannot carry any modifier roles. Survive to the end and <b>steal the victory of those foolish people</b>."
"role.madman.generalBlurb" : "You're the crazy ones"
"options.role.madman.detail" : "The Madman sees everything clearly, but not a word of his counts."
"options.modifier.madman.detail" : "The Madman sees everything clearly, but not a word of his counts."
"role.reveler.name" : "Reveler"
"role.reveler.short" : "Revel"
"role.reveler.blurb" : "What is pleasure? I am pleasure!"
"role.reveler.doc" : "Walk up to a task point to <b>sabotage that task point</b> (locked task points will have an outline).<br>Then <b>the first person to do a task at that point will die</b>, each trap only triggers once.<br>Design kills on enough people to win."
"role.reveler.generalBlurb" : "What is pleasure? I am pleasure!"
"options.role.reveler.detail" : "The Reveler turns task points into traps; anyone doing tasks on them dies."
"options.modifier.reveler.detail" : "The Reveler turns task points into traps."
"role.plumber.name" : "Plumber"
"role.plumber.short" : "Plumb"
"role.plumber.blurb" : "My name is Mario"
"role.plumber.doc" : "You can dive into pipes to <b>go outside the map</b> for a while. <b>Everyone knows of your existence from the start</b>, and <b>no one can win while you are alive</b>. If you are killed when only three people remain, <b>everyone wins together</b>."
"role.plumber.generalBlurb" : "My name is Mario"
"options.role.plumber.detail" : "The Plumber is a nail that must be dealt with first."
"options.modifier.plumber.detail" : "The Plumber is a nail that must be dealt with first."
"role.vindicator.name" : "Vindicator"
"role.vindicator.short" : "Veng"
"role.vindicator.blurb" : "How could you kill me..."
"role.vindicator.doc" : "When killed during the free phase, <b>your body disappears</b>. At the start of the next free phase, you rise with an <b>Enraged state</b>: you know the killer's location, cannot call meetings, and must take revenge within a time limit. <b>Knifing the wrong person makes the killer's faction win</b>; timing out kills you."
"role.vindicator.generalBlurb" : "How could you kill me..."
"options.role.vindicator.detail" : "The Vindicator trades one death for one chance at revenge."
"options.modifier.vindicator.detail" : "The Vindicator trades one death for one chance at revenge."
"role.artist.name" : "Artist"
"role.artist.short" : "Art"
"role.artist.blurb" : "I think I can paint the best picture"
"role.artist.doc" : "Give <b>paintings</b> to players. When the number of players on the field drops to a specified value, all painting holders <b>become your fans</b> and win with you."
"role.artist.generalBlurb" : "I think I can paint the best picture"
"options.role.artist.detail" : "The Artist wins hearts with their work."
"options.modifier.artist.detail" : "The Artist wins hearts with their work."
"role.savior.name" : "Savior"
"role.savior.short" : "Save"
"role.savior.blurb" : "Saving you is just a casual act"
"role.savior.doc" : "You can walk up to a body and <b>revive</b> it; the revived player becomes <b>Rescued</b> and wins with you — but <b>if you die, they die too</b>, and if they die, one rescue use is refunded.<br>During the action phase, you can use <b>Insight</b> on a player to learn <b>%NUM%</b> candidate roles at the start of the next meeting, <b>one of which is guaranteed to be their true role</b>.<br>In meetings, you can also <b>mark</b> someone as your believed role; the mark is only visible to you and the Rescued."
"role.savior.generalBlurb" : "Saving you is just a casual act"
"options.role.savior.detail" : "The Savior wins by accumulating living people."
"options.modifier.savior.detail" : "The Savior wins by accumulating living people."
"role.strayer.name" : "Strayer"
"role.strayer.short" : "Stray"
"role.strayer.blurb" : "Wandering astray"
"role.strayer.doc" : "At the start, you appear as a <b>Deputy</b>, and even you don't know the truth. After completing all tasks, you <b>awaken</b> and unlock a one-time knife. <b>If you are expelled in the meeting of the round you draw the knife, you win</b>; if you survive, you die immediately after the meeting ends."
"role.strayer.generalBlurb" : "Wandering astray"
"options.role.strayer.detail" : "The Strayer must first prove themselves, then destroy themselves."
"options.modifier.strayer.detail" : "The Strayer must first prove themselves, then destroy themselves."
"role.pureWhite.name" : "Pure White"
"role.pureWhite.short" : "White"
"role.pureWhite.blurb" : "You can only take on the colors of others."
"role.pureWhite.doc" : "Use <b>Color Mix</b> to join a player's faction; your knife is only unlocked after joining. You can see that person's role, but <b>they cannot see you</b>. Win with them."
"role.pureWhite.generalBlurb" : "You can only take on the colors of others."
"options.role.pureWhite.detail" : "Pure White has no color of its own and can only borrow others'."
"options.modifier.pureWhite.detail" : "Pure White has no color of its own and can only borrow others'."
"role.boss.name" : "Boss"
"role.boss.short" : "Boss"
"role.boss.blurb" : "Come to me, room and board included!"
"role.boss.doc" : "<b>Hire</b> a player to immediately become a Workaholic (original role not retained). <b>Hiring an Impostor wastes a use</b>. When a Workaholic's salary meets the threshold, if any faction achieves its win condition, you <b>steal the victory</b>. <b>When the last Workaholic dies, you die too.</b>"
"role.boss.generalBlurb" : "Come to me, room and board included!"
"options.role.boss.detail" : "The Boss turns others' victories into their own revenue."
"options.modifier.boss.detail" : "The Boss turns others' victories into their own revenue."
"role.workaholic.name" : "Workaholic"
"role.workaholic.short" : "Work"
"role.workaholic.blurb" : "You think you can work another 999 hours of overtime"
"role.workaholic.doc" : "Do tasks to earn <b>salary</b>: normal tasks +100. Salary <b>drains continuously every minute</b> (meetings don't count), and <b>reaching zero means bankruptcy and death</b>. When salary is high enough, the Boss can steal the victory."
"role.workaholic.generalBlurb" : "You think you can work another 999 hours of overtime"
"options.role.workaholic.detail" : "The Workaholic can only keep doing tasks to stay alive."
"options.modifier.workaholic.detail" : "The Workaholic can only keep doing tasks to stay alive."

