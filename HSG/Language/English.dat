"role.HIGH.generalBlurb" : "Growing upward"
"options.role.HIGH.detail" : "...<b>This is one of Half Sugar's gifts to you!</b>"
"role.HIGH.doc" : "Your height changes randomly.<br><b>You are the modern Tall One.</b><size=0.5><i>......Or maybe a dwarf</i></size>"
