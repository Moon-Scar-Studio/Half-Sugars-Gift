"options.role.caterpillar.eatToWin" : "勝利に必要な呑み込み人数"
"options.role.cinnabar.cooldown" : "クールダウン"
"options.role.cinnabar.maxMarks" : "点砂回数"
"options.role.coder.oncePerMeeting" : "会議ごとに1回まで"
"options.role.coder.penaltyCooldown" : "バグ発動後クールダウン"
