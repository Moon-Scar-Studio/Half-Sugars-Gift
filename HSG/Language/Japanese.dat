"options.role.compulsion.triggerChance" : "発作確率"
"options.role.count.executeOnlyOnce" : "処刑は1回のみ"
"options.role.count.extraTasks" : "追加継承タスク数"
"options.role.count.reviveNeedsTasks" : "復活にタスク完了が必要"
"options.role.crimson.channelUses" : "私密チャンネル回数"
"options.role.crimson.whisperUses" : "囁き回数"
"options.role.discerner.cooldown" : "クールダウン"
"options.role.discerner.markRounds" : "マーク有効ラウンド数"
"options.role.discerner.penalty" : "外れ時追加クールダウン"
"options.role.fanatic.independentWin" : "独立勝利"
"options.role.fanatic.killCooldown" : "殺害クールダウン"
"options.role.giver.candidateCount" : "候補職業数"
"options.role.giver.cooldown" : "クールダウン"
"options.role.giver.maxUses" : "使用回数"
"options.role.hunter.canTakeDead" : "死者を道連れにできる"
"options.role.hunter.selectTime" : "選択時間"
"options.role.jade.cooldown" : "クールダウン"
"options.role.jade.duration" : "護盾持続時間"
"options.role.jade.maxUses" : "使用回数"
"options.role.king.cooldown" : "クールダウン"
"options.role.king.secondCrown" : "2回目戴冠を解放"
"options.role.madman.survivors" : "強奪発動の残り人数"
"options.role.ochre.cooldown" : "クールダウン"
"options.role.ochre.maxUses" : "使用回数"
